# EC2 production env. 실제 값은 EC2 인스턴스에서 backend/.env 로 복사 후 채움.
# ⚠️ .env 는 .gitignore 처리되어 있음 — 절대 커밋 금지

# postgres
# 강력한 랜덤 비밀번호 생성: openssl rand -base64 32
POSTGRES_PASSWORD=__REPLACE_WITH_STRONG_RANDOM__

# backend (compose override 가 DATABASE_URL 을 postgres:5432 로 덮어쓰므로 여기는 fallback)
DATABASE_URL=postgresql://postgres:__REPLACE__@postgres:5432/ooh_recommend

OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536

# Vercel 도메인 추가 (콤마로 여러 origin 가능)
FRONTEND_URL=https://your-app.vercel.app

PORT=8000

# 로컬 개발: docker compose 가 호스트 5433 으로 postgres 노출, 컨테이너 내부에선 postgres:5432.
# 컨테이너 안에서 실행되는 backend 는 docker-compose env override 로 자동 셋팅 (postgres:5432).
# 호스트에서 직접 띄울 때만 아래 URL 사용.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ooh_recommend

# JWT 서명 시크릿 — 필수. 비우거나 change-me 기본값이면 서버가 기동되지 않는다.
# access/refresh 는 서로 다른 값으로. 생성 예: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

OPENAI_API_KEY=sk-...

LLM_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536

# Frontend (CORS) — 쉼표로 여러 origin 허용
FRONTEND_URL=http://localhost:3000,http://localhost:3001

PORT=8000

# Kakao OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3001/oauth/kakao/callback
# 카카오 로컬(주소 검색) REST API 키 — 엑셀 일괄 등록 주소 자동 입력. 비우면 KAKAO_CLIENT_ID 사용
KAKAO_REST_API_KEY=

# Naver OAuth
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:3001/oauth/naver/callback

# Geoapify (지오코딩)
GEOAPIFY_API_KEY=
# 서울 열린데이터광장 인증키 — 매체 정보 팝업의 실시간 인구(비면 카드 숨김)
SEOUL_OPENAPI_KEY=

# SMTP (메일 발송)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Google Analytics 4
GA4_PROPERTY_ID=
GA4_CREDENTIALS_PATH=secrets/your-ga4-credentials.json

# 매체 이미지 저장 위치 — 비우면 s3(운영 EC2, 인스턴스 역할로 인증). 로컬 개발에서만 local 로 켠다(AWS 인증 없이 /uploads 에 저장).
# MEDIA_IMAGE_STORAGE=local
